{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-health-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "migrations": [
    {
      "new_sqlite_classes": ["GoogleHealthMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GoogleHealthMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace with the id printed by: wrangler kv namespace create OAUTH_KV
      "id": "7a0347387a2a488da0f0f74c94fbd157"
    }
  ],
  "vars": {
    // Default Health API scopes requested from Google (read-only recovery data).
    "GOOGLE_OAUTH_SCOPES": "https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly"
  }
  // Secrets (set via `wrangler secret put`):
  //   GOOGLE_CLIENT_ID
  //   GOOGLE_CLIENT_SECRET
  //   COOKIE_ENCRYPTION_KEY   (any long random string)
}
